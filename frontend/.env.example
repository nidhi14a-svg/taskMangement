# Backend Public API Base URL (DO NOT put backend secrets or DB credentials here)
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"

# Application Name
NEXT_PUBLIC_APP_NAME="TaskFlow Management System"
