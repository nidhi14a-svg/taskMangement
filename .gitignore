# ==============================================================================
# Git Ignore Rules for TaskFlow Management System
# ==============================================================================

# Secrets and Environment Variables
.env
.env.*
!.env.example
*.pem
*.key
*.cert

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover

# Node.js & Frontend Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# Build Artifacts & Caches
dist/
frontend/dist/
.vite/
*.tsbuildinfo
.eslintcache
.oxlintcache

# Local Database Files
*.sqlite
*.sqlite3
*.db

# Operating System & IDE Files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
