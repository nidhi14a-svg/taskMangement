# ==============================================================================
# TaskFlow Management API - Environment Configuration Example
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# Application
PROJECT_NAME="TaskFlow Management API"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security (JWT & Password Hashing)
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY="development_secret_key_change_in_production_min_32_chars_long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# MongoDB Configuration (PyMongo Async API)
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB_NAME="taskflow_db"

# CORS Configuration (comma-separated origins or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
